rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userRole() {
      return request.auth.token.role != null ? request.auth.token.role.upper() : null;
    }

    function hasRole(allowedRoles) {
      return isAuthenticated() && (userRole() in allowedRoles);
    }

    function isSuperAdmin() { return hasRole(["SUPER_ADMIN"]); }
    function isAdmin() { return hasRole(["SUPER_ADMIN", "ADMIN"]); }
    function isSales() { return hasRole(["SUPER_ADMIN", "ADMIN", "SALES"]); }
    function isOps() { return hasRole(["SUPER_ADMIN", "ADMIN", "OPERATIONS"]); }
    function isTech() { return hasRole(["SUPER_ADMIN", "ADMIN", "OPERATIONS", "TECHNICIAN"]); }

    // ========================================================================
    // USER & CRM PROFILES
    // ========================================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isSuperAdmin();
    }

    match /customers/{customerId} {
      allow read: if isSales() || isTech() || (isAuthenticated() && resource.data.authUid == request.auth.uid);
      allow write: if false; // Only via backend API
    }

    match /leads/{leadId} {
      allow read: if isSales() || (isAuthenticated() && resource.data.firebase_uid == request.auth.uid);
      allow write: if false; // Only via backend API
    }

    // ========================================================================
    // PUBLIC CONFIG & CATALOG
    // ========================================================================

    match /products/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /addons/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /addon_rules/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /wizard_steps/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /comparison_card_layouts/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{document=**} { allow read: if true; allow write: if isSuperAdmin(); }
    match /amc_plans/{document=**} { allow read: if true; allow write: if isAdmin(); }

    // ========================================================================
    // OPERATIONS & INVENTORY (STRICT NO-CLIENT-WRITE)
    // ========================================================================

    match /inventory/{skuId} {
      allow read: if isOps() || isTech() || isSales();
      allow write: if false; // MUST BE DONE VIA BACKEND API TRANSACTIONS
    }
    
    match /stock_ledger/{docId} {
      allow read: if isOps() || isAdmin();
      allow write: if false; // Backend API only
    }

    match /inventory_exceptions/{docId} {
      allow read: if isOps() || isAdmin();
      allow write: if false; // Backend API only
    }

    match /jobs/{jobId} {
      allow read: if isTech() || isSales();
      allow write: if false; // Job dispatch & completion via Backend API
    }

    match /service_tickets/{ticketId} {
      allow read: if isTech() || isSales() || (isAuthenticated() && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.authUid == request.auth.uid);
      allow write: if false; 
    }

    match /serial_assets/{assetId} {
      allow read: if isTech() || isSales() || (isAuthenticated() && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.authUid == request.auth.uid);
      allow write: if false;
    }

    match /amc_contracts/{contractId} {
      allow read: if isTech() || isSales() || (isAuthenticated() && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.authUid == request.auth.uid);
      allow write: if false;
    }

    match /customer_warranty_items/{itemId} {
      allow read: if isTech() || isSales() || (isAuthenticated() && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.authUid == request.auth.uid);
      allow write: if false;
    }

    match /rma_requests/{rmaId} {
      allow read: if isOps() || isSales();
      allow write: if false;
    }

    // ========================================================================
    // FINANCE (NO-CLIENT-WRITE)
    // ========================================================================

    match /invoices/{invoiceId} {
      allow read: if isSales() || isOps() || (isAuthenticated() && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.authUid == request.auth.uid);
      allow write: if false;
    }

    match /receipts/{receiptId} {
      allow read: if isSales() || isOps() || (isAuthenticated() && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.authUid == request.auth.uid);
      allow write: if false;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
